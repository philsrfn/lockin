# Postgres — used by docker compose and by the server
POSTGRES_PASSWORD=lockin
POSTGRES_PORT=5433
DATABASE_URL=postgres://lockin:lockin@localhost:5433/lockin

# The single bearer token the app sends. Generate with:
#   openssl rand -hex 32
APP_BEARER_TOKEN=replace-me

PORT=3000
TZ=Europe/Berlin

# From AI Studio, on a Cloud project with billing enabled.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.6-flash
# Pro is not reachable on this key (404). Flash covers the weekly review
# until Pro access exists on the project.
GEMINI_MODEL_SMART=gemini-3.6-flash
# APNS_KEY_ID=
# APNS_TEAM_ID=

# Who may let themselves in. `invite` (the default) creates an account and waits
# for an operator to admit it in the admin panel — how this has always worked.
# `open` admits it immediately, which is what a public app has to do. What
# bounds the cost is the rate limiter and the per-athlete token ceiling, not
# this; approval only ever delayed it.
SIGNUP_MODE=invite

# Connections per process. The default suits one server; the integration tests
# set their own, lower, because a dozen of them run at once.
# PGPOOL_MAX=10
