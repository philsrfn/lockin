{
  "expo": {
    "name": "lockin",
    "slug": "lockin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.dotspiro.lockin",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "de"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "scheme": "lockin",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "lockin scans food barcodes to log what you eat."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4ADE80"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "So your coach can see your steps, sleep and resting heart rate without you having to type them in.",
          "NSHealthUpdateUsageDescription": "So the sessions you log here appear in Apple Health alongside everything else.",
          "background": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c01d9573-c065-4481-8923-87db6c41da4a"
      }
    },
    "owner": "philserafin"
  }
}
