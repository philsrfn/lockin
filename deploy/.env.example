# Copy to deploy/.env on the server. Never committed.

# The hostname the phone will talk to. Either a domain you own with an A record
# pointing at this server, or an sslip.io name if you do not have one:
#   1.2.3.4  ->  1-2-3-4.sslip.io
LOCKIN_DOMAIN=

# openssl rand -hex 32
POSTGRES_PASSWORD=

# Must match what you type into the app on first launch.
APP_BEARER_TOKEN=

GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.6-flash
GEMINI_MODEL_SMART=gemini-3.6-flash

TZ=Europe/Berlin
